{
  "name": "moreai",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "node apps/mobile/scripts/download-fonts.mjs && turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.5",
      "image-size": ">=2.0.3",
      "decode-uri-component": ">=0.5.1",
      "metro": "0.83.8",
      "metro-babel-transformer": "0.83.8",
      "metro-cache": "0.83.8",
      "metro-cache-key": "0.83.8",
      "metro-config": "0.83.8",
      "metro-core": "0.83.8",
      "metro-file-map": "0.83.8",
      "metro-minify-terser": "0.83.8",
      "metro-resolver": "0.83.8",
      "metro-runtime": "0.83.8",
      "metro-source-map": "0.83.8",
      "metro-symbolicate": "0.83.8",
      "metro-transform-plugins": "0.83.8",
      "metro-transform-worker": "0.83.8"
    }
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  }
}
